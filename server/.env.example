# Optional — only needed when running WITHOUT Docker
# When using Docker, set these as HF Space secrets instead.

# HuggingFace model (Hub repo ID or local path)
MODEL_NAME=Sohammore13/cyberbullying-detector

# Path to keyword override CSV
KEYWORDS_CSV=./abusive_words.csv

# ---------------------------------------------------------------------------
# Instagram Graph API integration
# ---------------------------------------------------------------------------

# From Meta App Dashboard → Settings → Basic
INSTAGRAM_APP_ID=your_app_id_here
INSTAGRAM_APP_SECRET=your_app_secret_here

# Must exactly match the Redirect URI registered in your Meta App Dashboard
# → Products → Facebook Login for Business → Settings → Valid OAuth Redirect URIs
# Local dev:
INSTAGRAM_REDIRECT_URI=http://localhost:8000/auth/instagram/callback
# HF Spaces (uncomment and fill in when deploying):
# INSTAGRAM_REDIRECT_URI=https://<your-username>-<your-space-name>.hf.space/auth/instagram/callback

# Where to send the user after a successful OAuth login
# Local dev:
FRONTEND_URL=http://localhost:5173
# HF Spaces (uncomment):
# FRONTEND_URL=https://<your-frontend-url>

# Secret key for signing the server-side session cookie.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit a real value here — put the real secret in HF Secrets or your CI/CD env.
SESSION_SECRET_KEY=replace_with_a_real_32_char_random_hex_string
