# ─────────────────────────────────────────────────────────────────────────────
# CiviScan Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# HuggingFace model (Hub repo ID)
MODEL_NAME=Sohammore13/cyberbullying-detector

# Path to keyword override CSV
KEYWORDS_CSV=./abusive_words.csv

# ---------------------------------------------------------------------------
# HuggingFace Inference API (required for DEPLOYMENT version only)
# ---------------------------------------------------------------------------
# Free HF account → Settings → Access Tokens → Create token (read-only)
# Without this, API is rate-limited to ~10 req/min (unauthenticated).
HF_TOKEN=

# ---------------------------------------------------------------------------
# YouTube Data API v3 integration
# ---------------------------------------------------------------------------
# From Google Cloud Console → APIs & Services → Credentials
# (enable "YouTube Data API v3" on the project first)
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# YouTube OAuth 2.0 — required for deleting toxic comments as channel owner
# ---------------------------------------------------------------------------
# 1. Go to Google Cloud Console → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (type: Web application)
# 3. Add http://localhost:8000/youtube/callback as an Authorized Redirect URI
#    (and your production URL when deploying)
# 4. Paste your client_id and client_secret below

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/youtube/callback

# URL of your frontend (used to redirect back after OAuth)
FRONTEND_URL=http://localhost:5173
